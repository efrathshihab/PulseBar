<Application x:Class="PulseBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- At startup App.xaml.cs applies the theme from settings (System/Light/Dark) -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="PulseBar"
                            NoLeftClickDelay="True">
                <!-- The icon (app logo, then live CPU %) is set from code: App.OnStartup and TrayIconUpdater -->
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Take screenshot" Click="TakeScreenshot_Click" />
                        <MenuItem Header="Show on taskbar"
                                  Tag="ShowOnTaskbar"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="ShowOnTaskbar_Click" />
                        <Separator />
                        <MenuItem Header="Quit" Click="Quit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
