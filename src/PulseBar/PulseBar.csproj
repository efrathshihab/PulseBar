<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- GpuMonitor: to read PDH instance names directly without building strings -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Shown in Settings > About; CI overrides it from the tag (-p:Version=1.0.1) -->
    <Version>1.0.0</Version>
    <Product>PulseBar</Product>
    <ApplicationIcon>Assets\PulseBar.ico</ApplicationIcon>

    <!-- Our own Program.Main, so VelopackApp runs before anything else (App.xaml has no Main) -->
    <StartupObject>PulseBar.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray logo (TrayIconRenderer.CreateLogo) and the popup header badge; logo.png is only the source -->
    <Resource Include="Assets\PulseBar.ico" />
    <Resource Include="Assets\logo-96.png" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!--
    Debug build: a running PulseBar keeps bin\Debug\PulseBar.exe locked, so dotnet run's build
    fails to copy it. So before the build it is sent the Quit event, and we wait until it exits
    (up to 5 seconds). This never runs for Release builds (local build-installer.ps1 and CI) or on CI.
  -->
  <UsingTask TaskName="QuitRunningPulseBar" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        try
        {
            EventWaitHandle quit;
            if (EventWaitHandle.TryOpenExisting(@"Local\PulseBar.Quit", out quit))
            {
                using (quit)
                {
                    quit.Set();
                }

                Log.LogMessage(MessageImportance.High, "PulseBar: asked the running instance to quit");
                var stopwatch = System.Diagnostics.Stopwatch.StartNew();
                while (stopwatch.ElapsedMilliseconds < 5000)
                {
                    Mutex mutex;
                    if (!Mutex.TryOpenExisting(@"Local\PulseBar.SingleInstance", out mutex))
                    {
                        break;
                    }

                    mutex.Dispose();
                    Thread.Sleep(100);
                }
            }
        }
        catch (Exception ex)
        {
            Log.LogMessage(MessageImportance.Low, "PulseBar quit check skipped: " + ex.Message);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Not CoreBuild: BeforeTargets runs after its DependsOn (including copy), which is too late -->
  <Target Name="QuitRunningDevInstance" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Debug' And '$(CI)' != 'true'">
    <QuitRunningPulseBar />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
