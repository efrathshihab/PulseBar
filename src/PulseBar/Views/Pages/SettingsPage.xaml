<UserControl x:Class="PulseBar.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PulseBar.ViewModels"
             xmlns:controls="clr-namespace:PulseBar.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,14,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Small text under a card; hidden when the value is null -->
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,2,4,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="128" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>

        <Style TargetType="controls:HotKeyBox">
            <Setter Property="Width" Value="140" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,4,0,0"
                  Padding="4,0,8,8">
        <StackPanel>
            <!-- ================= General ================= -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="General" Margin="2,4,0,6" />

            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Launch at login" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="With admin: needed for CPU temperature" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding LaunchOptions}"
                          SelectedValue="{Binding LaunchAtLogin}"
                          IsEnabled="{Binding IsLaunchEnabled}"
                          AutomationProperties.Name="Launch at login" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource Note}"
                       Text="{Binding LaunchMessage, Mode=OneWay, TargetNullValue=''}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <TextBlock Margin="4,2,4,4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LaunchIssue}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding LaunchIssue, Mode=OneWay}" />
                <Run Text=" · " />
                <Hyperlink Command="{Binding FixLaunchCommand}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           TextDecorations="None">Fix</Hyperlink>
            </TextBlock>

            <TextBlock Style="{StaticResource Note}"
                       Text="Debug build: this dev exe will start at login"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Visibility="{Binding ShowDebugWarning, Converter={StaticResource BoolToVisibility}}" />

            <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Theme" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedValue="{Binding Settings.Theme}"
                          AutomationProperties.Name="Theme" />
            </ui:CardControl>

            <!-- ================= Taskbar ================= -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Taskbar" />

            <ui:CardControl Icon="{ui:SymbolIcon Window24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Show on taskbar" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Live values next to the tray" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.ShowTaskbarOverlay}"
                                 AutomationProperties.Name="Show on taskbar" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon LayoutRowTwo24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Layout" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Compact: CPU, RAM · Balanced: + GPU, GPU temp" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding LayoutOptions}"
                          SelectedValue="{Binding Settings.OverlayLayout}"
                          AutomationProperties.Name="Taskbar layout" />
            </ui:CardControl>

            <!-- ================= Clipboard ================= -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Clipboard" />

            <ui:CardControl Icon="{ui:SymbolIcon Clipboard24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Clipboard history" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="When off, nothing new is saved; existing items stay" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.ClipboardEnabled}"
                                 AutomationProperties.Name="Clipboard history" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon History24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Keep history for" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Older items are deleted" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding RetentionOptions}"
                          SelectedValue="{Binding Settings.ClipboardRetention}"
                          AutomationProperties.Name="Keep history for" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" VerticalContentAlignment="Top">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Panel hotkey" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Opens the clipboard panel" />
                    </StackPanel>
                </ui:CardControl.Header>
                <controls:HotKeyBox DataContext="{Binding PanelHotKey}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ClipboardPaste24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Auto-paste" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Enter in the panel pastes directly" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.AutoPaste}"
                                 AutomationProperties.Name="Auto-paste" />
            </ui:CardControl>

            <!-- ================= Screenshots ================= -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Screenshots" />

            <ui:CardControl Icon="{ui:SymbolIcon Screenshot24}" VerticalContentAlignment="Top">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Screenshot hotkey" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Select an area to capture" />
                    </StackPanel>
                </ui:CardControl.Header>
                <controls:HotKeyBox DataContext="{Binding ScreenshotHotKey}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Watch Screenshots folder" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Add Win+PrtSc images to history" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.WatchScreenshotsFolder}"
                                 AutomationProperties.Name="Watch Screenshots folder" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ClipboardTextLtr24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Auto-copy" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Also copy new folder images to the clipboard" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.AutoCopyScreenshots}"
                                 AutomationProperties.Name="Auto-copy screenshots" />
            </ui:CardControl>

            <!-- ================= About ================= -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />

            <ui:CardControl Icon="{ui:SymbolIcon Info24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="PulseBar" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding VersionText, Mode=OneTime}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="GitHub"
                           Icon="{ui:SymbolIcon Open24}"
                           Command="{Binding OpenGitHubCommand}"
                           ToolTip="{x:Static vm:SettingsViewModel.GitHubUrl}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Updates" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Updates.StatusText, Mode=OneWay}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Check for updates"
                           Command="{Binding Updates.CheckNowCommand}"
                           IsEnabled="{Binding Updates.IsEnabled, Mode=OneTime}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Clock24}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Automatically check for updates" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Settings.AutoCheckUpdates}"
                                 IsEnabled="{Binding Updates.IsEnabled, Mode=OneTime}"
                                 AutomationProperties.Name="Automatically check for updates" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon DocumentText24}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Logs" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowReset24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Reset to defaults" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Restore all settings to their defaults" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Reset" Click="Reset_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
