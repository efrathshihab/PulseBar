<UserControl x:Class="PulseBar.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PulseBar.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}">
    <StackPanel Margin="8,12,8,8">
        <ui:TextBlock Text="{Binding CpuText}"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ui:TextBlock Text="{Binding RamText}"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ui:TextBlock Text="{Binding NetworkText}"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ui:TextBlock Text="{Binding TempText}"
                      ToolTip="{Binding TempToolTip}"
                      Background="Transparent"
                      FontTypography="BodyStrong"
                      Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding DriveLines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:TextBlock Text="{Binding}"
                                  FontTypography="BodyStrong"
                                  Margin="0,0,0,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
