<UserControl x:Class="PulseBar.Views.Pages.SoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PulseBar.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- প্রতিটা app এর row; সব রং theme থেকে -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AudioAppViewModel}">
            <Border Margin="0,0,0,6"
                    Padding="10,8,4,6"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App এর icon; না পেলে সাধারণ app icon -->
                    <Grid Grid.RowSpan="2"
                          Width="24"
                          Height="24"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon x:Name="FallbackIcon"
                                       Symbol="AppGeneric24"
                                       FontSize="20"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Slider x:Name="VolumeSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,2,0,0"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="1"
                            LargeChange="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Volume, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Name}" />

                    <TextBlock Grid.Column="2"
                               Grid.RowSpan="2"
                               Width="40"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               FontSize="12"
                               Text="{Binding VolumeText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:Button x:Name="MuteButton"
                               Grid.Column="3"
                               Grid.RowSpan="2"
                               Width="34"
                               Height="34"
                               Margin="2,0,0,0"
                               Padding="0"
                               VerticalAlignment="Center"
                               Appearance="Transparent"
                               ToolTip="Mute"
                               Command="{Binding ToggleMuteCommand}">
                        <ui:SymbolIcon x:Name="MuteIcon" Symbol="Speaker224" FontSize="18" />
                    </ui:Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="MuteIcon" Property="Symbol" Value="SpeakerMute24" />
                    <Setter TargetName="MuteButton" Property="ToolTip" Value="Unmute" />
                    <Setter TargetName="VolumeSlider" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Margin="4,12,4,4"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Apps}"
                          ItemTemplate="{StaticResource AppRowTemplate}"
                          Focusable="False" />

            <!-- System sounds ছাড়া কোনো app নেই -->
            <StackPanel Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="SpeakerOff28"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="এখন কোনো app শব্দ করছে না"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
