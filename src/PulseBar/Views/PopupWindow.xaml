<ui:FluentWindow x:Class="PulseBar.Views.PopupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:PulseBar.Views.Pages"
                 Title="PulseBar"
                 Width="380"
                 Height="560"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ShowActivated="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid Margin="12,12,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0"
                      Text="PulseBar"
                      FontTypography="Subtitle"
                      Margin="4,0,0,8" />

        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,4,0" />
                        <TextBlock Text="Overview" />
                    </StackPanel>
                </TabItem.Header>
                <pages:OverviewPage x:Name="OverviewTab" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,4,0" />
                        <TextBlock Text="Sound" />
                    </StackPanel>
                </TabItem.Header>
                <pages:SoundPage />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Clipboard24" Margin="0,0,4,0" />
                        <TextBlock Text="Clipboard" />
                    </StackPanel>
                </TabItem.Header>
                <pages:ClipboardPage />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,4,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </TabItem.Header>
                <pages:SettingsPage />
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
