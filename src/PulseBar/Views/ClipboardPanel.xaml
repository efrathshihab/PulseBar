<!--
    The small clipboard panel for the hotkey (default Ctrl+Alt+V): opens near the mouse cursor.
    Inside is the same ClipboardList as the popup's Clipboard tab, with the same ViewModel.
-->
<ui:FluentWindow x:Class="PulseBar.Views.ClipboardPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PulseBar.Views.Controls"
                 Title="PulseBar Clipboard"
                 Width="360"
                 Height="440"
                 MinWidth="0"
                 MinHeight="0"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ShowActivated="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid Margin="12,12,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ClipboardList x:Name="List" ShowClearAll="False" />

        <Grid Grid.Row="1" Margin="2,6,2,0" MinHeight="20">
            <TextBlock x:Name="HintText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- When the previous window runs as admin, Windows doesn't allow sending Ctrl+V: copy only then -->
            <Border x:Name="StatusBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="8,1"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="Copied — press Ctrl+V to paste"
                           FontSize="11"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
